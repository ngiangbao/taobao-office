{
  "name": "taobao-office",
  "desktopName": "taobao-office.desktop",
  "version": "0.3.0",
  "description": "Trợ lý order Taobao: chat với Claude, văn phòng 3D hiển thị việc đang làm",
  "main": "main.js",
  "author": "Taobao Office <noreply@example.com>",
  "homepage": "https://github.com/ngiangbao/taobao-office",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/sync-icons.mjs",
    "icons": "node scripts/sync-icons.mjs",
    "prepare:office": "node scripts/prepare-office.mjs",
    "dist:linux": "npm run icons && npm run prepare:office && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run icons && npm run prepare:office && electron-builder --win nsis --publish never",
    "dist:mac": "npm run icons && npm run prepare:office && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "vn.taobaooffice.app",
    "productName": "Taobao Office",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "linux": {
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "maintainer": "Taobao Office <noreply@example.com>"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "extraResources": [
      {
        "from": "office",
        "to": "office",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!**/*.map",
          ".next/**/*",
          "!.next/cache/**"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "ngiangbao",
        "repo": "taobao-office",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/@playwright/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.83",
    "electron-updater": "^6.8.11"
  }
}