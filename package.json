{
  "name": "taobao-office",
  "version": "0.1.0",
  "description": "Trợ lý order Taobao: chat với Claude, văn phòng 3D hiển thị việc đang làm",
  "main": "main.js",
  "author": "Taobao Office <noreply@example.com>",
  "homepage": "https://github.com/ngiangbao/taobao-office",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepare:office": "node scripts/prepare-office.mjs",
    "dist:linux": "npm run prepare:office && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run prepare:office && electron-builder --win nsis --publish never",
    "dist:mac": "npm run prepare:office && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "vn.taobaooffice.app",
    "productName": "Taobao Office",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "linux": {
      "category": "Office",
      "maintainer": "Taobao Office <noreply@example.com>"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "extraResources": [
      {
        "from": "office",
        "to": "office",
        "filter": [
          "**/*",
          "!.git",
          "!**/*.map",
          "!node_modules/.cache/**",
          "!.next/cache/**"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0"
  }
}